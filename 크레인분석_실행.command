#!/bin/bash
# Mac용 실행 파일

# 현재 스크립트가 있는 디렉토리로 이동
cd "$(dirname "$0")"

clear
echo "======================================================================"
echo "                    크레인 양중분석 프로그램"
echo "======================================================================"
echo ""

# Python 확인
if ! command -v python3 &> /dev/null
then
    echo "[오류] Python이 설치되어 있지 않습니다."
    echo ""
    echo "Python 설치 방법:"
    echo "1. 터미널에서 다음 명령어 실행:"
    echo "   brew install python3"
    echo ""
    read -p "Enter 키를 누르면 종료됩니다..."
    exit 1
fi

# 프로그램 실행
python3 example_usage.py

echo ""
echo "======================================================================"
echo "                        프로그램 실행 완료"
echo "======================================================================"
echo ""
read -p "Enter 키를 누르면 종료됩니다..."
